generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}


datasource db {
  provider = "mysql"
}


// PapÃ©is que um usuÃ¡rio pode ter no sistema
enum PapelUsuario {
  ADMIN
  GESTOR
  MEMBRO
  RESPONSAVEL_OSC
}


// SituaÃ§Ãµes possÃ­veis de um projeto
enum StatusProjeto {
  PLANEJAMENTO
  EM_ANDAMENTO
  CONCLUIDO
  PAUSADO
}


// SituaÃ§Ãµes possÃ­veis de uma aÃ§Ã£o
enum StatusAcao {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}


// SituaÃ§Ãµes possÃ­veis de uma demanda
enum StatusDemanda {
  ABERTA
  EM_ANALISE
  ATENDIDA
  RECUSADA
}


// UsuÃ¡rios que acessam o sistema
model Usuario {
  id        Int          @id @default(autoincrement())
  nome      String       @db.VarChar(120)
  email     String       @unique @db.VarChar(191)
  senha     String       @db.VarChar(255)
  papel     PapelUsuario
  telefone  String?      @db.VarChar(20)
  ativo     Boolean      @default(true)


  // Obrigatorio para RESPONSAVEL_OSC por regra de negocio.
  organizacaoId Int?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)


  projetosCriados     Projeto[]  @relation("ProjetosCriados")
  acoesResponsavel    Acao[]     @relation("ResponsavelAcao")
  demandasCriadas     Demanda[]  @relation("DemandasCriadas")
  demandasResponsavel Demanda[]  @relation("ResponsavelDemanda")


  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt


  @@index([organizacaoId])
  @@index([papel])
  @@index([ativo])
}


// OSCS
model Organizacao {
  id        Int     @id @default(autoincrement())
  nome      String  @db.VarChar(180)
  sigla     String? @db.VarChar(30)
  cnpj      String? @unique @db.VarChar(18)
  email     String? @db.VarChar(191)
  telefone  String? @db.VarChar(20)
  endereco   String? @db.VarChar(255)
  categoria  String? @db.VarChar(30)
  bairro     String? @db.VarChar(120)
  responsavel String? @db.VarChar(120)
  descricao  String? @db.Text


  usuarios     Usuario[]
  projetos     Projeto[]
  demandas     Demanda[]
  atendimentos RegistroAtendimento[]


  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}


// Projetos desenvolvidos pelas organizaÃ§Ãµes
model Projeto {
  id         Int           @id @default(autoincrement())
  titulo     String        @db.VarChar(180)
  descricao  String?       @db.Text
  status     StatusProjeto @default(PLANEJAMENTO)
  dataInicio DateTime?
  dataFim    DateTime?


  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)


  criadorId Int
  criador   Usuario @relation("ProjetosCriados", fields: [criadorId], references: [id], onDelete: Restrict)


  acoes        Acao[]
  atendimentos RegistroAtendimento[]


  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt


  @@index([organizacaoId])
  @@index([criadorId])
  @@index([status])
}


// AÃ§Ãµes ou atividades vinculadas a projetos
model Acao {
  id         Int        @id @default(autoincrement())
  titulo     String     @db.VarChar(180)
  descricao  String?    @db.Text
  status     StatusAcao @default(PENDENTE)
  dataInicio DateTime?
  dataFim    DateTime?


  projetoId Int
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Restrict)


  responsavelId Int?
  responsavel   Usuario? @relation("ResponsavelAcao", fields: [responsavelId], references: [id], onDelete: SetNull)


  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt


  @@index([projetoId])
  @@index([responsavelId])
  @@index([status])
}


// Demandas ou solicitaÃ§Ãµes registradas no sistema
model Demanda {
  id        Int           @id @default(autoincrement())
  titulo    String        @db.VarChar(180)
  descricao String        @db.Text
  status    StatusDemanda @default(ABERTA)


  organizacaoId Int?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)


  solicitanteId Int
  solicitante   Usuario @relation("DemandasCriadas", fields: [solicitanteId], references: [id], onDelete: Restrict)


  responsavelId Int?
  responsavel   Usuario? @relation("ResponsavelDemanda", fields: [responsavelId], references: [id], onDelete: SetNull)


  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt


  @@index([organizacaoId])
  @@index([solicitanteId])
  @@index([responsavelId])
  @@index([status])
}


// Registros usados para contabilizar atendimentos
model RegistroAtendimento {
  id         Int      @id @default(autoincrement())
  quantidade Int
  descricao  String?  @db.VarChar(255)
  data       DateTime @default(now())


  periodoInicio DateTime?
  periodoFim    DateTime?


  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)


  projetoId Int?
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: Restrict)


  criadoEm DateTime @default(now())


  @@index([organizacaoId])
  @@index([projetoId])
  @@index([data])
}
