
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Papéis que um usuário pode ter no sistema
enum PapelUsuario {
  ADMIN
  GESTOR
  MEMBRO
}

// Situações possíveis de um projeto
enum StatusProjeto {
  PLANEJAMENTO
  EM_ANDAMENTO
  CONCLUIDO
  PAUSADO
}

// Situações possíveis de uma ação
enum StatusAcao {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

// Situações possíveis de uma demanda
enum StatusDemanda {
  ABERTA
  EM_ANALISE
  ATENDIDA
  RECUSADA
}

// Usuários que acessam o sistema
model Usuario {
  id        Int          @id @default(autoincrement())
  nome      String       @db.VarChar(120)
  email     String       @unique @db.VarChar(191)
  senha     String       @db.VarChar(255)
  papel     PapelUsuario @default(MEMBRO)
  telefone  String?      @db.VarChar(20)
  ativo     Boolean      @default(true)

  // Organização à qual o usuário está vinculado
  organizacaoId Int?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id])

  // Projetos criados pelo usuário
  projetosCriados Projeto[] @relation("ProjetosCriados")

  // Ações pelas quais o usuário é responsável
  acoesResponsavel Acao[] @relation("ResponsavelAcao")

  // Demandas abertas pelo usuário
  demandasCriadas Demanda[] @relation("DemandasCriadas")

  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
}

// Organizações da sociedade civil (OSCs)
model Organizacao {
  id        Int     @id @default(autoincrement())
  nome      String  @db.VarChar(180)
  sigla     String? @db.VarChar(30)
  cnpj      String? @unique @db.VarChar(18)
  email     String? @db.VarChar(191)
  telefone  String? @db.VarChar(20)
  endereco  String? @db.VarChar(255)
  descricao String? @db.Text

  
  usuarios     Usuario[]
  projetos     Projeto[]
  demandas     Demanda[]
  atendimentos RegistroAtendimento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Projetos desenvolvidos pelas organizações
model Projeto {
  id        Int           @id @default(autoincrement())
  titulo    String        @db.VarChar(180)
  descricao String?       @db.Text
  status    StatusProjeto @default(PLANEJAMENTO)
  dataInicio DateTime?
  dataFim    DateTime?

  // Organização responsável pelo projeto
  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])

 
  criadorId Int
  criador   Usuario @relation("ProjetosCriados", fields: [criadorId], references: [id])


  acoes        Acao[]
  atendimentos RegistroAtendimento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Ações ou atividades vinculadas a projetos
model Acao {
  id        Int        @id @default(autoincrement())
  titulo    String     @db.VarChar(180)
  descricao String?    @db.Text
  status    StatusAcao @default(PENDENTE)
  dataInicio DateTime?
  dataFim    DateTime?

  // Projeto ao qual a ação pertence
  projetoId Int
  projeto   Projeto @relation(fields: [projetoId], references: [id])

  // Responsável pela execução da ação
  responsavelId Int?
  responsavel   Usuario? @relation("ResponsavelAcao", fields: [responsavelId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Demandas ou solicitações registradas no sistema
model Demanda {
  id        Int           @id @default(autoincrement())
  titulo    String        @db.VarChar(180)
  descricao String        @db.Text
  status    StatusDemanda @default(ABERTA)

  // Organização relacionada à demanda, se houver
  organizacaoId Int?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id])

  // Usuário que registrou a demanda
  solicitanteId Int
  solicitante   Usuario @relation("DemandasCriadas", fields: [solicitanteId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Registros usados para contabilizar atendimentos
model RegistroAtendimento {
  id         Int      @id @default(autoincrement())
  quantidade Int
  descricao  String?  @db.VarChar(255)
  data       DateTime @default(now())

  // Organização responsável pelo atendimento
  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])

  // Projeto relacionado, caso exista
  projetoId Int?
  projeto   Projeto? @relation(fields: [projetoId], references: [id])

  criadoEm DateTime @default(now())
}
