generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Papéis que um usuário pode ter no sistema
enum PapelUsuario {
  ADMIN
  RESPONSAVEL_UOSCC
  RESPONSAVEL_OSC
}

// Situações de uma solicitação de cadastro/acesso
enum StatusSolicitacao {
  PENDENTE
  APROVADA
  RECUSADA
}

// Tipo de solicitação
enum TipoSolicitacao {
  VINCULO_OSC
  NOVA_OSC
}

enum TipoProjeto {
  GERAL
  ESPECIFICO
}

// Situações possíveis de um projeto
enum StatusProjeto {
  PLANEJAMENTO
  EM_ANDAMENTO
  CONCLUIDO
  PAUSADO
}

// Situações possíveis de uma ação
enum StatusAcao {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

// Situações possíveis de uma demanda
enum StatusDemanda {
  ABERTA
  EM_ANALISE
  ATENDIDA
  RECUSADA
}

// Categorias de uma demanda
enum CategoriaDemanda {
  MATERIAIS
  VOLUNTARIOS
  FINANCEIRO
  SERVICOS
  OUTROS
}

// Usuários que acessam o sistema
model Usuario {
  id       Int          @id @default(autoincrement())
  nome     String       @db.VarChar(120)
  email    String       @unique @db.VarChar(191)
  senha    String       @db.VarChar(255)
  papel    PapelUsuario
  telefone String?      @db.VarChar(20)
  ativo    Boolean      @default(true)
  // Campo legado preservado para compatibilidade; não concede permissões.
  dono     Boolean      @default(false)

  organizacaoId Int?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  projetosCriados          Projeto[]             @relation("ProjetosCriados")
  acoesResponsavel         Acao[]                @relation("ResponsavelAcao")
  demandasCriadas          Demanda[]             @relation("DemandasCriadas")
  demandasResponsavel      Demanda[]             @relation("ResponsavelDemanda")
  historicoDemandas        DemandaHistorico[]
  solicitacoesAnalisadas   SolicitacaoCadastro[] @relation("SolicitacoesAnalisadas")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([organizacaoId])
  @@index([papel])
  @@index([ativo])
}

// OSCs
model Organizacao {
  id          Int     @id @default(autoincrement())
  nome        String  @db.VarChar(180)
  sigla       String? @db.VarChar(30)
  cnpj        String? @unique @db.VarChar(18)
  email       String? @db.VarChar(191)
  telefone    String? @db.VarChar(20)
  endereco    String? @db.VarChar(255)
  categoria   String? @db.VarChar(30)
  bairro      String? @db.VarChar(120)
  responsavel String? @db.VarChar(120)
  descricao   String? @db.Text

  ativa        Boolean @default(true)
  projetosGerais Projeto[] @relation("ParticipantesProjeto")

  usuarios     Usuario[]
  projetos     Projeto[]
  demandas     Demanda[]
  atendimentos RegistroAtendimento[]
  solicitacoes SolicitacaoCadastro[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Nova tabela para o fluxo de cadastro e vínculo sem duplicação
model SolicitacaoCadastro {
  id              Int               @id @default(autoincrement())
  tipo            TipoSolicitacao
  status          StatusSolicitacao @default(PENDENTE)

  nomeUsuario     String            @db.VarChar(120)
  emailUsuario    String            @db.VarChar(191)
  senhaUsuario    String            @db.VarChar(255)
  telefoneUsuario String?           @db.VarChar(20)

  // Preenchido no Cenário A (Vínculo)
  organizacaoId   Int?
  organizacao     Organizacao?      @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  // Preenchido no Cenário B (Nova OSC)
  nomeOsc         String?           @db.VarChar(180)
  cnpj            String?           @db.VarChar(18)
  categoria       String?           @db.VarChar(30)
  endereco        String?           @db.VarChar(255)
  bairro          String?           @db.VarChar(120)
  telefoneOsc     String?           @db.VarChar(20)
  emailOsc        String?           @db.VarChar(191)
  descricaoOsc    String?           @db.Text

  motivoRecusa    String?           @db.Text
  analisadoPorId  Int?
  analisadoPor    Usuario?          @relation("SolicitacoesAnalisadas", fields: [analisadoPorId], references: [id], onDelete: SetNull)
  dataAnalise     DateTime?

  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt

  @@index([status])
  @@index([tipo])
  @@index([cnpj])
  @@index([emailUsuario])
  @@index([organizacaoId])
  @@index([analisadoPorId])
}

// Projetos desenvolvidos pelas organizações
model Projeto {
  tipo TipoProjeto @default(ESPECIFICO)
  todasOscs Boolean @default(false)
  participantes Organizacao[] @relation("ParticipantesProjeto")
  id         Int           @id @default(autoincrement())
  titulo     String        @db.VarChar(180)
  descricao  String?       @db.Text
  status     StatusProjeto @default(PLANEJAMENTO)
  dataInicio DateTime?
  dataFim    DateTime?

  objetivo    String?  @db.Text
  resultados  String?  @db.Text
  orcamento   Decimal? @db.Decimal(12, 2)
  responsavel String?  @db.VarChar(120)
  telefone    String?  @db.VarChar(20)
  email       String?  @db.VarChar(191)

  organizacaoId Int?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  criadorId Int
  criador   Usuario @relation("ProjetosCriados", fields: [criadorId], references: [id], onDelete: Restrict)

  acoes        Acao[]
  atendimentos RegistroAtendimento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([organizacaoId])
  @@index([criadorId])
  @@index([status])
}

// Ações ou atividades vinculadas a projetos
model Acao {
  id         Int        @id @default(autoincrement())
  titulo     String     @db.VarChar(180)
  descricao  String?    @db.Text
  status     StatusAcao @default(PENDENTE)
  dataInicio DateTime?
  dataFim    DateTime?

  projetoId Int
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Restrict)

  responsavelId Int?
  responsavel   Usuario? @relation("ResponsavelAcao", fields: [responsavelId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([projetoId])
  @@index([responsavelId])
  @@index([status])
}

// Demandas ou solicitações registradas no sistema
model Demanda {
  versao    Int @default(0)
  historico DemandaHistorico[]
  id        Int              @id @default(autoincrement())
  titulo    String           @db.VarChar(180)
  descricao String           @db.Text
  status    StatusDemanda    @default(ABERTA)
  categoria CategoriaDemanda @default(OUTROS)

  prazo         DateTime?
  dataConclusao DateTime?
  resultado     String?   @db.Text

  organizacaoId Int?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  solicitanteId Int
  solicitante   Usuario @relation("DemandasCriadas", fields: [solicitanteId], references: [id], onDelete: Restrict)

  responsavelId Int?
  responsavel   Usuario? @relation("ResponsavelDemanda", fields: [responsavelId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([organizacaoId])
  @@index([solicitanteId])
  @@index([responsavelId])
  @@index([status])
  @@index([categoria])
}

// Registros usados para contabilizar atendimentos
model RegistroAtendimento {
  id         Int      @id @default(autoincrement())
  quantidade Int
  descricao  String?  @db.VarChar(255)
  data       DateTime @default(now())

  periodoInicio DateTime?
  periodoFim    DateTime?

  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  projetoId Int?
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())

  @@index([organizacaoId])
  @@index([projetoId])
  @@index([data])
}

// Registros imutáveis do atendimento; respostas e observações são visíveis à OSC vinculada.
model DemandaHistorico {
  id Int @id @default(autoincrement())
  demandaId Int
  demanda Demanda @relation(fields: [demandaId], references: [id], onDelete: Restrict)
  usuarioId Int
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tipo String @db.VarChar(20)
  statusAnterior StatusDemanda?
  statusNovo StatusDemanda
  resposta String? @db.Text
  observacao String? @db.Text
  criadoEm DateTime @default(now())

  @@index([demandaId, criadoEm])
  @@index([usuarioId])
}
